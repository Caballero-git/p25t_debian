// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Teclast P25T (2023, model code P9A6) - RK3566 tablet.
 *
 * Stage 2 tree: SD card, USB-C (peripheral), ADC keys, display (VOP2 -> DSI0 ->
 * JD9365 panel) and PWM backlight. I2C0 enabled WITHOUT child nodes, only for
 * read-only register dumps of the RK817 PMIC from user space.
 * Deliberately NO PMIC (RK817), NO vdd_cpu regulator (SYR837), NO eMMC:
 * the kernel must not change any voltage or touch Android on the eMMC.
 * All supplies are declared as dummy fixed regulators matching the values the
 * stock bootloader already set up.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/soc/rockchip,vop2.h>
#include "rk3566.dtsi"

/ {
	model = "Teclast P25T (P9A6)";
	compatible = "teclast,p25t", "rockchip,rk3566";

	aliases {
		mmc1 = &sdmmc0;
		mmc2 = &sdmmc1;
	};

	chosen {
		stdout-path = "serial2:1500000n8";
	};

	/* Dummy fixed supplies: describe, never switch. */
	vcc_sys_dummy: regulator-vcc-sys-dummy {
		compatible = "regulator-fixed";
		regulator-name = "vcc_sys_dummy";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3800000>;
		regulator-max-microvolt = <3800000>;
	};

	vcc_3v3_dummy: regulator-vcc-3v3-dummy {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3_dummy";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_sys_dummy>;
	};

	vcc_1v8_dummy: regulator-vcc-1v8-dummy {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8_dummy";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc_sys_dummy>;
	};

	/* Panel power switch: GPIO3_B1 (stock "enable-gpios", active high). */
	vcc_lcd: regulator-vcc-lcd {
		compatible = "regulator-fixed";
		regulator-name = "vcc_lcd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio3 RK_PB1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <20000>;
		vin-supply = <&vcc_3v3_dummy>;
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm14 0 25000 0>;
		brightness-levels = <7 255>;
		num-interpolated-steps = <248>;
		default-brightness-level = <120>;
		power-supply = <&vcc_sys_dummy>;
	};

	/*
	 * Wi-Fi/BT module AIC8800 (SDIO on sdmmc1). From the stock DT and the
	 * stock mmc-pwrseq driver: GPIO0_A0 switches the module's supply (low =
	 * on), GPIO0_C0 is WL_REG_ON (high = running). The 32 kHz sleep clock
	 * comes from RK817 CLK32KOUT2, which is already enabled at reset
	 * (reg 0xF2 bit 7 = 1), so no PMIC write is needed.
	 */
	vcc_wl: regulator-vcc-wl {
		compatible = "regulator-fixed";
		regulator-name = "vcc_wl";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio0 RK_PA0 GPIO_ACTIVE_LOW>;
		startup-delay-us = <100000>;
		vin-supply = <&vcc_3v3_dummy>;
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpio0 RK_PC0 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <50>;
		power-off-delay-us = <5000>;
	};

	/* Volume keys on SARADC channel 0 (thresholds from the stock DT). */
	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 0>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;

		button-vol-up {
			label = "volume up";
			linux,code = <KEY_VOLUMEUP>;
			press-threshold-microvolt = <1750>;
		};

		button-vol-down {
			label = "volume down";
			linux,code = <KEY_VOLUMEDOWN>;
			press-threshold-microvolt = <1297500>;
		};
	};

	/*
	 * Battery data for the RK817 charger, copied from the stock Android
	 * device tree (Firmware/dt/boot-0-0x6c0fe00.dts: design_capacity,
	 * chrg_finish_cur, max_chrg_current, max_chrg_voltage,
	 * zero_algorithm_vol, and the 21-point OCV table), converted to the
	 * generic power-supply/battery.yaml units mainline's rk817_charger
	 * driver expects. Cross-checked for units/shape against a real
	 * mainline board using the same driver (rk3566-pinetab2.dtsi).
	 */
	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <5300000>;
		charge-term-current-microamp = <200000>;
		constant-charge-current-max-microamp = <2000000>;
		constant-charge-voltage-max-microvolt = <4350000>;
		voltage-max-design-microvolt = <4350000>;
		voltage-min-design-microvolt = <3400000>;

		ocv-capacity-celsius = <20>;
		ocv-capacity-table-0 = <4313000 100>, <4257000 95>, <4199000 90>, <4144000 85>,
				       <4093000 80>, <4035000 75>, <3992000 70>, <3955000 65>,
				       <3915000 60>, <3866000 55>, <3834000 50>, <3804000 45>,
				       <3788000 40>, <3776000 35>, <3765000 30>, <3745000 25>,
				       <3724000 20>, <3677000 15>, <3608000 10>, <3543000 5>,
				       <3400000 0>;
	};

	/*
	 * Analog audio via the RK817 codec (patch 0015). "Analog RK817" name
	 * and mclk-fs=256 (48kHz*256=12.288MHz) copied from the real
	 * rk3566-quartz64-a.dts reference board - same codec, same i2s1_8ch
	 * cpu-side controller. See the pmic@20/rk817 node comment above and
	 * &i2s1_8ch below for the clock/pin details.
	 */
	rk817-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "Analog RK817";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;

		simple-audio-card,cpu {
			sound-dai = <&i2s1_8ch>;
		};

		simple-audio-card,codec {
			sound-dai = <&rk817>;
		};
	};
};

&saradc {
	vref-supply = <&vcc_1v8_dummy>;
	status = "okay";
};

/* microSD slot: stays at 3.3 V signalling (no UHS), like the stock loader left it. */
&sdmmc0 {
	bus-width = <4>;
	cap-sd-highspeed;
	disable-wp;
	no-1-8-v;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
	vmmc-supply = <&vcc_3v3_dummy>;
	vqmmc-supply = <&vcc_3v3_dummy>;
	status = "okay";
};

/* SDIO Wi-Fi (AIC8800), 4-bit, 50 MHz like the stock kernel. */
&sdmmc1 {
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	max-frequency = <50000000>;
	mmc-pwrseq = <&sdio_pwrseq>;
	non-removable;
	disable-wp;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc1_bus4 &sdmmc1_cmd &sdmmc1_clk>;
	vmmc-supply = <&vcc_wl>;
	status = "okay";
};

/*
 * IO domain vccio4 (SDIO pins) is fed by RK817 LDO1 = 1.8 V (reg 0xCC = 0x30).
 * vccio1 (audio codec IO, patch 0015) added the same way stock has it:
 * fed by RK817 LDO_REG4 (vccio_acodec, 3.3 V) - see pmic@20/regulators.
 */
&pmu_io_domains {
	vccio1-supply = <&vccio_acodec>;
	vccio4-supply = <&vcc_1v8_dummy>;
	status = "okay";
};

/*
 * Bluetooth half of the AIC8800: H4 over UART1 (uart1m0 pins, RTS/CTS), 1.5 Mbaud,
 * attached from user space with btattach. BT_REG_ON = GPIO0_C1, high = on
 * (stock rfkill-bt: BT,reset_gpio GPIO0_C1 flags 0, driven high to power on).
 */
&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1m0_xfer &uart1m0_ctsn &uart1m0_rtsn>;
	uart-has-rtscts;
	status = "okay";
};

&gpio0 {
	bt-reg-on-hog {
		gpio-hog;
		gpios = <RK_PC1 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "bt_reg_on";
	};
};

&uart2 {
	status = "okay";
};

/* USB-C port as a USB device: gives the PC a serial console and network link. */
&usb_host0_xhci {
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	phys = <&usb2phy0_otg>;
	phy-names = "usb2-phy";
	/*
	 * Same DWC3 quirks as the stock Android device tree. Without
	 * dis-u2-freeclk-exists the controller expects a free-running UTMI
	 * clock while the USB2 PHY is suspended (no cable); it has none, so
	 * enabling ep0 times out ("failed to enable ep0out") and the PC then
	 * gets no answer (-71).
	 */
	snps,dis_enblslpm_quirk;
	snps,dis-u2-freeclk-exists-quirk;
	snps,dis-del-phy-power-chg-quirk;
	snps,dis-tx-ipgap-linecheck-quirk;
	status = "okay";
};

&usb2phy0 {
	status = "okay";
};

&usb2phy0_otg {
	status = "okay";
};

/* ---------------- Clocks ----------------
 * dclk_vop1 cannot change its parent PLL's rate (CLK_SET_RATE_NO_REPARENT, no
 * SET_RATE_PARENT), and our boot path skips the stock U-Boot that used to set up
 * VPLL. Without this VPLL stays in slow mode and the panel gets a 24 MHz pixel
 * clock instead of 67 MHz (seen in clk_summary: dclk_vop1 = 24000000).
 * 1608 MHz / 24 = 67.000 MHz exactly.
 */
&cru {
	assigned-clocks = <&pmucru CLK_RTC_32K>, <&cru PLL_GPLL>,
			  <&pmucru PLL_PPLL>, <&cru PLL_VPLL>;
	assigned-clock-rates = <32768>, <1200000000>,
			       <200000000>, <1608000000>;
};

/* ---------------- Display ---------------- */

&vop {
	assigned-clocks = <&cru DCLK_VOP0>, <&cru DCLK_VOP1>;
	assigned-clock-parents = <&pmucru PLL_HPLL>, <&cru PLL_VPLL>;
	status = "okay";
};

&vop_mmu {
	status = "okay";
};

&vp1 {
	vp1_out_dsi0: endpoint@ROCKCHIP_VOP2_EP_MIPI0 {
		reg = <ROCKCHIP_VOP2_EP_MIPI0>;
		remote-endpoint = <&dsi0_in_vp1>;
	};
};

&dsi_dphy0 {
	status = "okay";
};

&dsi0 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	panel@0 {
		compatible = "teclast,p25t-panel";
		reg = <0>;
		backlight = <&backlight>;
		reset-gpios = <&gpio3 RK_PC3 GPIO_ACTIVE_LOW>;
		vdd-supply = <&vcc_lcd>;
		vccio-supply = <&vcc_1v8_dummy>;

		port {
			mipi_in_panel: endpoint {
				remote-endpoint = <&mipi_out_panel>;
			};
		};
	};

	ports {
		dsi0_in: port@0 {
			reg = <0>;
			dsi0_in_vp1: endpoint {
				remote-endpoint = <&vp1_out_dsi0>;
			};
		};

		dsi0_out: port@1 {
			reg = <1>;
			mipi_out_panel: endpoint {
				remote-endpoint = <&mipi_in_panel>;
			};
		};
	};
};

&pwm14 {
	status = "okay";
};

/*
 * I2C0: RK817 PMIC @0x20 (BOOST/OTG_SWITCH regulators + charger/battery,
 * patches 0008-0009; DCDC_REG2/vdd_gpu, patch 0014; audio codec +
 * vccio_acodec, patch 0015) and SYR837 @0x40 (vdd_cpu, patch 0011). The
 * RK817 node itself stays deliberately minimal beyond that (no pwrkey
 * node - came up for free once the chip had any node at all). Values
 * copied verbatim from the stock Android
 * device tree (Firmware/dt/boot-0-0x6c0fe00.dts):
 *   - BOOST: regulator-always-on there too - stock never turns this rail
 *     off, we are not switching on anything stock treats as off.
 *   - OTG_SWITCH: stock leaves it switchable (its own USB HAL enables it
 *     only in host role via an extcon we never wired up). We only ever
 *     enable it through &usb2phy0_otg's phy-supply in the host-mode DTB
 *     variant (see rk3566-teclast-p25t-usbhost.dts) - the normal DTB
 *     never references it, so it stays unused/off there, same as today.
 *   - DCDC_REG2/vdd_gpu: stock has both regulator-always-on AND
 *     regulator-boot-on on this one (unlike BOOST) - mirrored exactly.
 */
&i2c0 {
	status = "okay";

	/*
	 * Real vdd_cpu chip on this board, confirmed from the stock DT (which
	 * lists four alternative vdd_cpu parts - generic Rockchip SDK board
	 * file - only this one is actually populated here). Values copied
	 * verbatim from the stock DT's syr837@40 node (min/max/ramp-delay,
	 * fcs,suspend-voltage-selector, always-on); the stock DT's own
	 * regulator-init-microvolt/regulator-initial-state are Rockchip
	 * BSP-only properties with no mainline binding, so they are not
	 * carried over - just reporting the chip's existing state on probe,
	 * never forcing a voltage. vin-supply matches stock's vcc3v8_sys via
	 * our existing vcc_sys_dummy. Feeds &cpu0..&cpu3's cpu-supply below,
	 * for real DVFS on top of the cpufreq-dt scaling already active from
	 * rk3566.dtsi's cpu0_opp_table. See kernel.org/hardware.org.
	 */
	vdd_cpu: regulator@40 {
		compatible = "silergy,syr827";
		reg = <0x40>;
		vin-supply = <&vcc_sys_dummy>;
		regulator-name = "vdd_cpu";
		regulator-min-microvolt = <712500>;
		regulator-max-microvolt = <1500000>;
		regulator-ramp-delay = <1000>;
		fcs,suspend-voltage-selector = <1>;
		regulator-always-on;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	rk817: pmic@20 {
		compatible = "rockchip,rk817";
		reg = <0x20>;
		interrupt-parent = <&gpio0>;
		interrupts = <3 8>; /* GPIO0_A3, IRQ_TYPE_LEVEL_LOW - matches stock */

		/*
		 * Audio codec (patch 0015). Mainline's rk817_codec.c has no
		 * separate DT subnode - #sound-dai-cells/clocks live directly on
		 * this node, matching sound/soc/codecs/rk817_codec.c's
		 * devm_clk_get(dev.parent, "mclk") and the rockchip,rk817.yaml
		 * binding's own top-level example. Stock's codec{} subnode
		 * (clocks=<&cru 0x1a3>, pinctrl-0, hp-volume/spk-volume/
		 * capture-volume/use-ext-amplifier/spk-ctl-gpios) is Rockchip
		 * BSP-only: rockchip,rk817.yaml's codec: schema only recognises
		 * rockchip,mic-in-differential, and clock ID 0x1a3=419 has no
		 * matching macro anywhere in mainline's rk3568-cru.h (only an
		 * unrelated reset macro shares that number) - it doesn't exist
		 * as a distinct clock in mainline's clk-rk3568.c at all, so it
		 * cannot be carried over. Values below copied instead from a
		 * real, working mainline board with the same chip combo
		 * (arch/arm64/boot/dts/rockchip/rk3566-quartz64-a.dts), and
		 * cross-checked against Documentation/devicetree/bindings/sound/
		 * rockchip,i2s-tdm.yaml's own worked example, which uses the
		 * identical &i2s1_8ch + i2s1m0 + trcm-sync-tx-only combination.
		 *
		 * spk-ctl-gpios deliberately NOT carried over: stock's value
		 * (<&gpio3 2 ...>, GPIO3_A2) is the exact same physical pin
		 * already confirmed on real hardware to be the SC7A20
		 * accelerometer's IRQ line (patch 0013) - a single pin cannot
		 * serve both. The quartz64-a reference board doesn't wire any
		 * speaker-amp GPIO either, so this is omitted rather than
		 * guessed. Practical effect, unconfirmed until tested: the
		 * built-in speaker's amplifier may need to be enabled some
		 * other way (or may default on/off in hardware) - headphone
		 * jack output should be unaffected either way. See
		 * hardware.org/todo.org.
		 */
		assigned-clocks = <&cru I2S1_MCLKOUT_TX>;
		assigned-clock-parents = <&cru CLK_I2S1_8CH_TX>;
		clocks = <&cru I2S1_MCLKOUT_TX>;
		clock-names = "mclk";
		pinctrl-names = "default";
		pinctrl-0 = <&i2s1m0_mclk>;
		#sound-dai-cells = <0>;

		regulators {
			rk817_boost: BOOST {
				regulator-name = "boost";
				regulator-min-microvolt = <4900000>;
				regulator-max-microvolt = <5400000>;
				/*
				 * Left unconstrained on purpose (matches the stock DT,
				 * which has no always-on flag either): nothing in the
				 * normal/peripheral DTB consumes this rail, so Linux
				 * disables it at late boot. The host-mode DTB overrides
				 * this node back to always-on/boot-on, since OTG_SWITCH's
				 * phy-supply link needs it live. See hardware.org/todo.org.
				 */
			};

			rk817_otg_switch: OTG_SWITCH {
				regulator-name = "otg_switch";
			};

			/*
			 * GPU rail. Values copied verbatim from the stock DT's own
			 * DCDC_REG2 (regulator-name is "vdd_gpu" there too, confirming
			 * this is the right rail). Stock's regulator-init-microvolt
			 * (900000) and regulator-initial-mode (2) are Rockchip
			 * BSP-only properties with no mainline binding (checked
			 * against /schemas/regulator/regulator.yaml, which is all
			 * rockchip,rk817.yaml references for this node) - dropped,
			 * same treatment as vdd_cpu's equivalent stock properties.
			 * Feeds &gpu's mali-supply below, for Panfrost GPU DVFS on
			 * top of rk3568.dtsi's existing gpu_opp_table. See
			 * kernel.org/hardware.org.
			 */
			vdd_gpu: DCDC_REG2 {
				regulator-name = "vdd_gpu";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <6001>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			/*
			 * Audio codec IO/analog supply (patch 0015). Stock's own
			 * LDO_REG4 is named "vccio_acodec" and is the vccio1-supply
			 * for &pmu_io_domains below - same always-on/boot-on
			 * treatment as stock, no BSP-only properties on this one.
			 */
			vccio_acodec: LDO_REG4 {
				regulator-name = "vccio_acodec";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
		};

		charger {
			monitored-battery = <&battery>;
			rockchip,resistor-sense-micro-ohms = <10000>;
			rockchip,sleep-enter-current-microamp = <150000>;
			rockchip,sleep-filter-current-microamp = <100000>;
		};
	};
};

/*
 * Real DVFS: cpu0_opp_table (rk3566.dtsi) already lists a min/target/max
 * microvolt triplet per frequency step; without a cpu-supply the OPP core
 * still lets cpufreq-dt scale frequency (already confirmed active), but
 * never touches voltage. Wiring vdd_cpu here lets it scale both.
 */
&cpu0 {
	cpu-supply = <&vdd_cpu>;
};

&cpu1 {
	cpu-supply = <&vdd_cpu>;
};

&cpu2 {
	cpu-supply = <&vdd_cpu>;
};

&cpu3 {
	cpu-supply = <&vdd_cpu>;
};

/*
 * I2C1: the stock DT lists TWO alternative accelerometers here, both
 * marked status="okay" unlike vdd_cpu's four alternatives on i2c0 (only
 * one of which was real) - so Android probes both and whichever chip
 * actually answers wins. Patch 0012 enabled the bus with no child node
 * and confirmed on hardware (tests/test_02.sh, see kernel.org) which one
 * is really here:
 *   - sensor@19  "gs_sc7a20"  0x19 - PRESENT. WHOAMI (reg 0x0f) reads
 *     back 0x11, which does not match the generic ST LIS3DH/LIS2DH12
 *     family (0x33) - but mainline already carries a dedicated entry
 *     for this exact clone: drivers/iio/accel/st_accel_i2c.c's
 *     "silan,sc7a20" compatible -> st_accel_core.c's SC7A20_ACCEL_DEV_NAME
 *     sensor_settings, wai = 0x11 (comment there: "Not an ST part.
 *     Register-compatible with the LIS2DH, even though the WAI value is
 *     different."). No new driver needed.
 *   - sensorda@27 "gs_da223"  0x27 - NOT present (no ACK). Moot now, but
 *     for the record: no mainline driver exists for this chip at all.
 * i2c1 also feeds the touchscreen (Silead GSL3673 @0x40, separate TODO).
 */
&i2c1 {
	status = "okay";

	/*
	 * IRQ: stock DT's irq-gpio = <0x3e 0x02 0x08> (0x3e is gpio@fe760000,
	 * i.e. gpio3) decodes to GPIO3_A2 (bank 3, pin 2), flags 0x08 =
	 * IRQ_TYPE_LEVEL_LOW - same
	 * raw-cells style already used for RK817's interrupt above (bank's
	 * own interrupt-cells = <2>: pin-in-bank, IRQ_TYPE_* flag).
	 *
	 * mount-matrix: stock DT has no such property - it instead carries
	 * Android-specific boolean flags (swap_xy=1, revert_x=0, revert_y=1,
	 * revert_z=0) consumed by a closed-source sensor HAL/driver we don't
	 * have access to, not any documented mainline binding. The matrix
	 * below is our best-effort translation, assuming the common
	 * "swap first, then negate" convention:
	 *   swapped = swap_xy ? (rawY, rawX) : (rawX, rawY)
	 *   out     = (revert_x ? -swapped.x : swapped.x,
	 *              revert_y ? -swapped.y : swapped.y,
	 *              revert_z ? -swapped.z : swapped.z)
	 * which with these flags gives out = (rawY, -rawX, rawZ), i.e. the
	 * matrix below. NOT verified against the real Android driver source
	 * (proprietary, unavailable) - only against the four flag values
	 * themselves. Treat screen-rotation/orientation behaviour as
	 * unconfirmed until checked against real tilt tests; see
	 * hardware.org/todo.org.
	 */
	accelerometer@19 {
		compatible = "silan,sc7a20";
		reg = <0x19>;
		interrupt-parent = <&gpio3>;
		interrupts = <2 8>; /* GPIO3_A2, IRQ_TYPE_LEVEL_LOW - matches stock */
		mount-matrix = "0", "1", "0",
				"-1", "0", "0",
				"0", "0", "1";
	};
};

/*
 * GPU (Panfrost/Mali Bifrost). Disabled by default in rk356x-base.dtsi;
 * rk3568.dtsi already wires operating-points-v2 = <&gpu_opp_table> onto
 * &gpu (200-800 MHz, no changes needed there). We only need to turn it on
 * and wire the real rail - mali-supply is the property name the mainline
 * binding (Documentation/devicetree/bindings/gpu/arm,mali-bifrost.yaml,
 * matching our exact compatible "rockchip,rk3568-mali") expects, and
 * stock's own GPU node uses the same property name for the same purpose.
 */
&gpu {
	status = "okay";
	mali-supply = <&vdd_gpu>;
};

/*
 * I2S1 (patch 0015): cpu side of the RK817 audio codec (see rk817-sound
 * and pmic@20/rk817 above). Already fully wired in rk356x-base.dtsi
 * (clocks, DMA, resets) - just disabled by default, same shape as &gpu
 * was. pinctrl-0 (single data line each way) + rockchip,trcm-sync-tx-only
 * copied verbatim from Documentation/devicetree/bindings/sound/
 * rockchip,i2s-tdm.yaml's own worked example and from the real
 * rk3566-quartz64-a.dts reference board, which uses this exact
 * controller+codec combination.
 */
&i2s1_8ch {
	pinctrl-names = "default";
	pinctrl-0 = <&i2s1m0_sclktx &i2s1m0_lrcktx &i2s1m0_sdi0 &i2s1m0_sdo0>;
	rockchip,trcm-sync-tx-only;
	status = "okay";
};
